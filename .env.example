# URL do endpoint serverless do chat (opcional; padrão: /api/chat)
VITE_CHAT_API_URL=/api/chat

# ==============================================================================
# VARIÁVEIS EXCLUSIVAS DE SERVIDOR (NUNCA usar prefixo VITE_ nem commitar .env)
# ==============================================================================
# Chave da API do Google Gemini (usada por api/chat.ts e pelo proxy local de dev)
GEMINI_API_KEY=coloque_sua_chave_gemini_aqui

# Modelo Gemini utilizado pelo Garden CLI Chat (padrão: gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash
